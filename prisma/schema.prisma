generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // generate also runs in the docker build before tsconfig.json is copied, and without it prisma defaults to .ts imports
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  name        String
  description String?
  unitAmount  Int      @map("unit_amount")
  currency    String   @default("usd") @db.Char(3)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  cancelled

  @@map("order_status")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  email           String
  status          OrderStatus @default(pending_payment)
  currency        String      @db.Char(3)
  totalAmount     Int         @map("total_amount")
  paymentIntentId String?     @unique @map("payment_intent_id") @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items          OrderItem[]
  idempotencyKey IdempotencyKey?

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  sku        String
  name       String
  unitAmount Int    @map("unit_amount")
  quantity   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model IdempotencyKey {
  key         String   @id @db.VarChar(255)
  requestHash String   @map("request_hash") @db.Char(64)
  orderId     String?  @unique @map("order_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("idempotency_keys")
}

model StripeEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(255)
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("stripe_events")
}
