PORT=3000

# postgres holds products, orders and payment state
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce

# any sk_test_ key works against stripe-mock. to use real stripe test mode, put your own
# test key here and remove STRIPE_API_URL
STRIPE_SECRET_KEY=sk_test_123
STRIPE_API_URL=http://localhost:12111

# signing secret of the webhook endpoint (whsec_...). with the stripe cli, `stripe listen` prints one
STRIPE_WEBHOOK_SECRET=whsec_test

# pending_payment orders older than this get their intent cancelled and their stock released
ORDER_PAYMENT_TTL_MINUTES=30
